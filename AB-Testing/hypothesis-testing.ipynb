        "import math\nfrom statistics import NormalDist\n",
        "n1,c1=1000,120;n2,c2=1000,145\n",
        "p1=c1/n1;p2=c2/n2\np=(c1+c2)/(n1+n2)\n",
        "se=math.sqrt(p*(1-p)*(1/n1+1/n2))\n",
        "z=(p2-p1)/se\n",
        "pval=2*(1-NormalDist().cdf(abs(z)))\n",
        "print(p1,p2,z,pval)\n"
